<Window x:Class="Tubase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tubase — オーディオ制作" Icon="Assets/Tubase.ico" Width="1280" Height="760" MinWidth="860" MinHeight="560"
        Background="#1B1D22" Foreground="#E3E5E8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen" WindowState="Normal"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="#24262B" BorderBrush="#111317" BorderThickness="0,0,0,1">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="38" Background="#202227">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock Text="TUBASE" Foreground="#62C8B2" FontWeight="Bold" FontSize="14" Margin="0,0,14,0" VerticalAlignment="Center"/>
            <Menu Background="Transparent" Foreground="#E3E5E8" VerticalAlignment="Center">
              <MenuItem Header="ファイル">
                <MenuItem Header="新規プロジェクト" Click="NewProject_Click"/><MenuItem Header="プロジェクトを開く" Click="OpenProject_Click"/>
              <Separator/><MenuItem Header="保存" InputGestureText="Ctrl+S" Click="SaveProject_Click"/><MenuItem Header="名前を付けて保存" Click="SaveProjectAs_Click"/>
                <Separator/><MenuItem Header="WAVを読み込む" Click="ImportWav_Click"/><MenuItem Header="WAVを書き出す" Click="ExportWav_Click"/>
              </MenuItem>
              <MenuItem Header="編集"><MenuItem Header="元に戻す" InputGestureText="Ctrl+Z" Click="Undo_Click"/><MenuItem Header="やり直す" InputGestureText="Ctrl+Y" Click="Redo_Click"/></MenuItem>
              <MenuItem Header="表示"><MenuItem Header="ズームを拡大" Click="ZoomIn_Click"/><MenuItem Header="ズームを縮小" Click="ZoomOut_Click"/></MenuItem>
              <MenuItem Header="ヘルプ" Click="Help_Click"/>
            </Menu>
          </StackPanel>
          <TextBlock x:Name="ProjectText" Grid.Column="1" Text="プロジェクトなし" Foreground="#A6ABB4" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <WrapPanel DockPanel.Dock="Bottom" Margin="6,3" VerticalAlignment="Center">
          <Button Content="新規" Click="NewProject_Click"/><Button Content="開く" Click="OpenProject_Click"/><Button Content="保存" Click="SaveProject_Click"/><Button Content="別名保存" Click="SaveProjectAs_Click"/>
          <Separator Width="1" Margin="8,2" Background="#555A64"/>
          <Button Content="＋ トラック" Click="AddTrack_Click"/><Button Content="WAV読込" Click="ImportWav_Click"/><Button Content="WAV書出" Click="ExportWav_Click"/>
          <Separator Width="1" Margin="8,2" Background="#555A64"/>
          <Button x:Name="UndoButton" Content="↶ 元に戻す" Click="Undo_Click"/><Button x:Name="RedoButton" Content="↷ やり直す" Click="Redo_Click"/>
          <Separator Width="1" Margin="8,2" Background="#555A64"/>
          <Button x:Name="PlayButton" Content="▶" ToolTip="再生／一時停止（Space）" FontSize="16" Click="Play_Click"/><Button Content="■" ToolTip="停止して先頭へ" FontSize="16" Click="Stop_Click"/>
          <TextBlock x:Name="PositionText" Text="00:00.000" Margin="12,7" FontFamily="Consolas" FontSize="16" Foreground="#75D6C0" VerticalAlignment="Center"/>
          <TextBlock Text="ズーム" Margin="8,8,2,8" Foreground="#A6ABB4" VerticalAlignment="Center"/>
          <Slider x:Name="ZoomSlider" Width="130" Minimum="35" Maximum="180" Value="80" ValueChanged="ZoomSlider_Changed" VerticalAlignment="Center"/>
          <TextBlock Text="スナップ" Margin="10,8,3,8" Foreground="#A6ABB4" VerticalAlignment="Center"/><CheckBox x:Name="SnapCheck" IsChecked="True" VerticalAlignment="Center" ToolTip="0.25秒グリッドに吸着"/>
          <ToggleButton x:Name="RightZoneToggle" Content="右ゾーン" IsChecked="False" Margin="10,2,3,2" Padding="8,4" VerticalAlignment="Center" ToolTip="右ゾーンの表示／非表示" Checked="RightZoneToggle_Changed" Unchecked="RightZoneToggle_Changed"/>
        </WrapPanel>
      </DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="#24262B" Foreground="#A6ABB4" BorderBrush="#111317" BorderThickness="0,1,0,0">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="プロジェクトを新規作成するか開いてください。"/></StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="44.1 kHz  ·  Windows オーディオ"/></StatusBarItem>
    </StatusBar>
    <Border DockPanel.Dock="Bottom" Height="30" Background="#202227" BorderBrush="#101115" BorderThickness="0,1,0,0">
      <TextBlock Text="Ctrl+S 保存　 Ctrl+Z 元に戻す　 Ctrl+Y やり直す　 Space 再生／停止" Foreground="#858B95" Margin="12,7"/>
    </Border>
    <Grid x:Name="ProjectLayoutGrid" Background="#191B20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="InspectorColumn" Width="230" MinWidth="150"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition x:Name="ProjectZoneColumn" Width="*" MinWidth="360"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition x:Name="RightZoneColumn" Width="0" MinWidth="0"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#23252A" BorderBrush="#111317" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Top" Background="#292B31" BorderBrush="#111317" BorderThickness="0,0,0,1" Padding="12,10">
            <StackPanel>
              <TextBlock Text="インスペクター" FontWeight="SemiBold" Foreground="#BEC2C9"/>
              <TextBlock Text="選択トラック" FontSize="10" Foreground="#858B95" Margin="0,10,0,2"/>
              <TextBlock x:Name="InspectorTrackName" Text="トラックなし" FontSize="14" FontWeight="SemiBold" Foreground="#F0F1F3" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="InspectorTrackDetails" Text="トラックを選択してください" FontSize="11" Foreground="#A6ABB4" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <StackPanel Margin="12,12">
            <TextBlock Text="選択イベント" FontSize="10" FontWeight="SemiBold" Foreground="#858B95"/>
            <TextBlock x:Name="InspectorEventName" Text="クリップを選択してください" FontSize="13" Foreground="#E3E5E8" Margin="0,5,0,2" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="InspectorEventDetails" Text="" FontSize="11" Foreground="#A6ABB4" TextWrapping="Wrap"/>
            <TextBlock x:Name="InspectorMediaStatus" Text="" FontSize="10" Foreground="#75D6C0" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <Border Height="1" Background="#383B43" Margin="0,14,0,12"/>
            <TextBlock Text="トラックコントロール" FontSize="10" FontWeight="SemiBold" Foreground="#858B95"/>
            <TextBlock Text="音量" FontSize="11" Foreground="#A6ABB4" Margin="0,8,0,2"/>
            <DockPanel LastChildFill="True"><TextBlock x:Name="InspectorGainValue" DockPanel.Dock="Right" Text="100%" Width="48" TextAlignment="Right" VerticalAlignment="Center" Foreground="#E3E5E8"/><Slider x:Name="InspectorGain" Minimum="0" Maximum="2" Value="1" PreviewMouseLeftButtonDown="InspectorControl_PreviewMouseLeftButtonDown" PreviewKeyDown="InspectorControl_PreviewKeyDown" ValueChanged="InspectorGain_ValueChanged" ToolTip="0〜200%"/></DockPanel>
            <TextBlock Text="パン" FontSize="11" Foreground="#A6ABB4" Margin="0,10,0,2"/>
            <DockPanel LastChildFill="True"><TextBlock x:Name="InspectorPanValue" DockPanel.Dock="Right" Text="中央" Width="64" TextAlignment="Right" VerticalAlignment="Center" Foreground="#E3E5E8"/><Slider x:Name="InspectorPan" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.1" IsSnapToTickEnabled="False" PreviewMouseLeftButtonDown="InspectorControl_PreviewMouseLeftButtonDown" PreviewKeyDown="InspectorControl_PreviewKeyDown" ValueChanged="InspectorPan_ValueChanged" ToolTip="左 ← 中央 → 右"/></DockPanel>
            <Grid Margin="5,1,67,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="左" Foreground="#858B95" FontSize="10"/><TextBlock Grid.Column="1" Text="中央" HorizontalAlignment="Center" Foreground="#858B95" FontSize="10"/><TextBlock Grid.Column="2" Text="右" HorizontalAlignment="Right" Foreground="#858B95" FontSize="10"/></Grid>
          </StackPanel>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="#111317" ShowsPreview="False"/>
      <Border Grid.Column="2" Background="#191B20">
        <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#191B20" CanContentScroll="False">
          <StackPanel x:Name="TracksPanel"/>
        </ScrollViewer>
      </Border>
      <GridSplitter x:Name="RightZoneSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#111317" ShowsPreview="False" Visibility="Collapsed" DragCompleted="RightZoneSplitter_DragCompleted"/>
      <Border x:Name="RightZonePane" Grid.Column="4" Background="#23252A" BorderBrush="#111317" BorderThickness="1,0,0,0" Visibility="Collapsed" MinWidth="150">
        <Grid>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
            <TextBlock Text="右ゾーン" FontSize="14" FontWeight="SemiBold" Foreground="#BEC2C9" HorizontalAlignment="Center"/>
            <TextBlock Text="表示項目はありません。" FontSize="11" Foreground="#858B95" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="180"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
