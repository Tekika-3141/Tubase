<Window x:Class="Tubase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tubase — Audio Production" Width="1440" Height="900" MinWidth="1050" MinHeight="650"
        Background="#1B1D22" Foreground="#E3E5E8" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="#24262B" BorderBrush="#111317" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="42" Background="#202227">
          <TextBlock Text="TUBASE" Foreground="#62C8B2" FontWeight="Bold" FontSize="16" Margin="16,0,18,0" VerticalAlignment="Center"/>
          <Button Content="File"/><Button Content="Edit"/><Button Content="Project"/><Button Content="Audio"/><Button Content="Help"/>
          <TextBlock x:Name="ProjectText" Text="No project" Foreground="#A6ABB4" Margin="24,0" VerticalAlignment="Center"/>
        </StackPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="6,3" VerticalAlignment="Center">
          <Button Content="New Project" Click="NewProject_Click"/><Button Content="Open" Click="OpenProject_Click"/><Button Content="Save" Click="SaveProject_Click"/>
          <Separator Width="1" Margin="8,2" Background="#555A64"/>
          <Button Content="＋ Track" Click="AddTrack_Click"/><Button Content="Import WAV" Click="ImportWav_Click"/><Button Content="Export WAV" Click="ExportWav_Click"/>
          <Separator Width="1" Margin="8,2" Background="#555A64"/>
          <Button x:Name="UndoButton" Content="↶ Undo" Click="Undo_Click"/><Button x:Name="RedoButton" Content="↷ Redo" Click="Redo_Click"/>
          <Separator Width="1" Margin="8,2" Background="#555A64"/>
          <Button x:Name="PlayButton" Content="▶" FontSize="16" Click="Play_Click"/><Button Content="■" FontSize="16" Click="Stop_Click"/>
          <TextBlock x:Name="PositionText" Text="00:00.000" Margin="12,7" FontFamily="Consolas" FontSize="16" Foreground="#75D6C0" VerticalAlignment="Center"/>
          <TextBlock Text="Zoom" Margin="8,8,2,8" Foreground="#A6ABB4" VerticalAlignment="Center"/>
          <Slider x:Name="ZoomSlider" Width="130" Minimum="35" Maximum="180" Value="80" ValueChanged="ZoomSlider_Changed" VerticalAlignment="Center"/>
          <TextBlock Text="Snap" Margin="10,8,3,8" Foreground="#A6ABB4" VerticalAlignment="Center"/><CheckBox x:Name="SnapCheck" IsChecked="True" VerticalAlignment="Center"/>
        </WrapPanel>
      </DockPanel>
    </Border>
    <StatusBar DockPanel.Dock="Bottom" Background="#24262B" Foreground="#A6ABB4" BorderBrush="#111317" BorderThickness="0,1,0,0">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Create or open a project to begin."/></StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="44.1 kHz  ·  24-bit UI  ·  Windows Audio"/></StatusBarItem>
    </StatusBar>
    <Border DockPanel.Dock="Bottom" Height="34" Background="#202227" BorderBrush="#101115" BorderThickness="0,1,0,0">
      <DockPanel><TextBlock Text="Inspector" FontWeight="SemiBold" Foreground="#BEC2C9" Margin="12,8"/><TextBlock Text="Select a track or event to edit.   |   Ctrl+S Save   Ctrl+Z Undo   Ctrl+Y Redo   Space Play/Stop" Foreground="#858B95" Margin="14,8"/></DockPanel>
    </Border>
    <ScrollViewer x:Name="TimelineScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#191B20" CanContentScroll="False">
      <StackPanel x:Name="TracksPanel"/>
    </ScrollViewer>
  </DockPanel>
</Window>
