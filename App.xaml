<Application x:Class="Tubase.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#20232B"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#292D37"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4ED6B4"/>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Foreground" Value="#F3F4F6"/>
      <Setter Property="Background" Value="#3A404C"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </Application.Resources>
</Application>
