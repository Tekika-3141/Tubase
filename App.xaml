<Application x:Class="Tubase.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#20232B"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#292D37"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4ED6B4"/>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Foreground" Value="#E4E6EA"/>
      <Setter Property="Background" Value="#35383F"/>
      <Setter Property="BorderBrush" Value="#484B52"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#464A52"/><Setter Property="BorderBrush" Value="#62C8B2"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#286C60"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C6C9CF"/><Setter Property="Margin" Value="4,2"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="#62C8B2"/><Setter Property="Margin" Value="4,2"/>
    </Style>
  </Application.Resources>
</Application>
